# Copy to .env for local database scripts. Never commit real credentials.
# MaxMind downloads use HTTP Basic auth; both account ID and license key are required.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Needed for remote R2/D1 provisioning, publishing, and deployment.
# Token needs D1: Edit in addition to the Worker/R2/zone permissions in README.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional preflight D1 size ceiling. Default: 500000000 (500 MB).
# Increase only within your account's per-database limit (paid maximum: 10000000000).
D1_MAX_BYTES=

# Optional ceiling on rows written by one D1 import. Default: 1500000, which keeps
# a daily import within the Workers Paid allowance of 50M rows written per month.
D1_MAX_ROWS=
