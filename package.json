{
  "name": "geoip",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:runtime": "bun run build && bun tests/runtime-smoke.ts",
    "bench:lookup": "bun tests/lookup-benchmark.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:download": "bun scripts/download-databases.ts",
    "db:publish": "bun scripts/publish-databases.ts",
    "db:update": "bun run db:download && bun run db:publish",
    "db:local": "bun run db:download && bun scripts/publish-databases.ts --local",
    "infra:ensure": "bun scripts/ensure-bucket.ts"
  },
  "dependencies": {
    "ipaddr.js": "^2.3.0",
    "mmdb-lib": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/bun": "^1.3.0",
    "miniflare": "5.20260903.0-alpha",
    "typescript": "^6.0.2",
    "wrangler": "^4.129.0"
  }
}
