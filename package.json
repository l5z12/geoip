{
  "name": "geoip",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "pnpm run build && node --import=tsx tests/runtime-smoke.ts",
    "bench:lookup": "node --import=tsx tests/lookup-benchmark.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:download": "node --env-file-if-exists=.env --import=tsx scripts/download-databases.ts",
    "db:publish": "node --env-file-if-exists=.env --import=tsx scripts/publish-databases.ts",
    "db:update": "pnpm run db:download && pnpm run db:publish",
    "db:local": "pnpm run db:download && pnpm run db:publish --local",
    "infra:ensure": "node --env-file-if-exists=.env --import=tsx scripts/ensure-bucket.ts"
  },
  "dependencies": {
    "ipaddr.js": "^2.3.0",
    "mmdb-lib": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^24.19.2",
    "miniflare": "5.20260903.0-alpha",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.129.0"
  }
}
